# =====================================================
# core-api Environment Variables
# =====================================================
# - 이 파일은 템플릿입니다. 실제 값은 .env 또는 .env.local 에 작성하세요.
# - 비밀값은 절대 커밋하지 않습니다.
# - 운영 환경에서는 AWS Secrets Manager / SSM Parameter Store 사용 권장.
#
# 참고: docs/ENVIRONMENT.md

# --- Runtime ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# --- CORS ---
# 콤마(,)로 구분된 허용 origin 목록. * 도 허용 (개발용)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/song4u

# --- AWS / S3 ---
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=song4u-audio-dev
# Presigned URL 만료 시간 (초). 기본 900 = 15분
S3_PRESIGN_EXPIRES_IN=900

# --- inference-api ---
INFERENCE_API_URL=http://localhost:8000
INFERENCE_API_KEY=
# inference 호출 timeout (ms). API_CONTRACTS.md / PIPELINE.md 의 P99 기준 여유 포함
INFERENCE_TIMEOUT_MS=20000

# --- Auth (Phase 2~) ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
